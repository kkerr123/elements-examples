{
  "name": "@nexus/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Nexus Desktop App - Agent Orchestration Platform",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:main\" \"pnpm dev:preload\" \"pnpm dev:renderer\" \"pnpm dev:electron\"",
    "dev:main": "esbuild main/index.ts --bundle --platform=node --outfile=dist/main/index.js --external:electron --define:process.env.NODE_ENV=\\\"development\\\" --watch",
    "dev:preload": "esbuild main/preload.ts --bundle --platform=node --outfile=dist/main/preload.js --external:electron --watch",
    "dev:renderer": "vite",
    "dev:electron": "sleep 3 && electron .",
    "build": "pnpm build:main && pnpm build:preload && pnpm build:renderer",
    "build:main": "esbuild main/index.ts --bundle --platform=node --outfile=dist/main/index.js --external:electron --minify",
    "build:preload": "esbuild main/preload.ts --bundle --platform=node --outfile=dist/main/preload.js --external:electron --minify",
    "build:renderer": "vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nexus/shared": "workspace:*",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "esbuild": "^0.19.11",
    "lucide-react": "^0.312.0",
    "postcss": "^8.4.33",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  }
}
